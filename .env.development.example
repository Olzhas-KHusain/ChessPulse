# ChessPulse — DEVELOPMENT environment (copy to .env.development).
#
#   cp .env.development.example .env.development
#   docker compose --env-file .env.development up -d --build --wait
#
# This file is a template. `.env.development` is git-ignored and must never be
# committed. The values here are local placeholders, not credentials.
#
# Development is intentionally *isolated* from the production-shaped stack:
# a different Compose project name means a different database volume, a
# different host port and a different container namespace. The two stacks can
# run at the same time.

# --- Environment identity -----------------------------------------------------
# Project name prefixes containers and the PostgreSQL volume.
COMPOSE_PROJECT_NAME=chesspulse-dev
# `development` enables /docs and /openapi.json; never use it for production.
APP_ENV=development
APP_BIND=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# --- Local PostgreSQL ---------------------------------------------------------
POSTGRES_USER=chesspulse
POSTGRES_PASSWORD=change_me_dev
POSTGRES_DB=chesspulse
# 5432 for development; production-shaped runs use 5433 so both can coexist.
POSTGRES_PORT=5432

# --- OpenTelemetry ------------------------------------------------------------
# The collector from observability/ publishes 4318 on the host.
# Set OTEL_ENABLED=false to run without the observability stack.
OTEL_ENABLED=true
OTEL_SERVICE_NAME=chesspulse
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
# `key=value,key2=value2`; leave empty locally.
OTEL_EXPORTER_OTLP_HEADERS=
# Sample every trace locally; production uses a much smaller ratio.
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_METRIC_EXPORT_INTERVAL_MS=15000
OTEL_LOGS_ENABLED=true

# --- Observability stack (observability/docker-compose.observability.yml) -----
# Grafana is published on 127.0.0.1:3000. Change this before exposing it.
GRAFANA_ADMIN_PASSWORD=change_me_grafana
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
# Shared secret for POST /alerts on the on-call service. Generate a random value.
ONCALL_TOKEN=change_me_oncall
# Where the on-call responder posts its diagnosis. Empty = log only.
ALERT_WEBHOOK_URL=
# Optional OpenAI-compatible LLM. Empty = deterministic runbook mode.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20

# --- Chess.com provider -------------------------------------------------------
CHESS_COM_USER_AGENT=ChessPulse/0.1.0 (contact: change-me@example.com)
UPSTREAM_TIMEOUT_SECONDS=10
UPSTREAM_MAX_RETRIES=2
UPSTREAM_MAX_RETRY_AFTER_SECONDS=10

# --- Cache and analysis -------------------------------------------------------
CACHE_TTL_SECONDS=43200
REFRESH_FAILURE_COOLDOWN_SECONDS=300
STOCKFISH_PATH=/usr/games/stockfish
ANALYSIS_DEPTH=12
ANALYSIS_THREADS=1
ANALYSIS_HASH_MB=64
ANALYSIS_JOB_MAX_ATTEMPTS=3
ANALYSIS_WORKER_POLL_SECONDS=2
ANALYSIS_STALE_JOB_MINUTES=30
