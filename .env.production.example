# ChessPulse — PRODUCTION-SHAPED environment (copy to .env.production).
#
#   cp .env.production.example .env.production
#   docker compose --env-file .env.production up -d --build --wait
#
# This is the local/VM stack that behaves like production. It is *not* the
# Render deployment (that one is configured in render.yaml and the Render
# dashboard) and it is *not* promoted automatically — see
# docs/observability.md and docs/deployment.md.
#
# This file is a template. `.env.production` is git-ignored and must never be
# committed. Every secret must be replaced before the stack is exposed.

# --- Environment identity -----------------------------------------------------
# A separate project name and volume from development.
COMPOSE_PROJECT_NAME=chesspulse-prod
# `production` disables /docs, /redoc and /openapi.json.
APP_ENV=production
# Keep it on localhost unless a reverse proxy terminates TLS in front.
APP_BIND=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# --- Local PostgreSQL ---------------------------------------------------------
POSTGRES_USER=chesspulse
POSTGRES_PASSWORD=replace_with_a_strong_random_password
POSTGRES_DB=chesspulse
# 5433 so the development stack can run at the same time on 5432.
POSTGRES_PORT=5433

# --- OpenTelemetry ------------------------------------------------------------
# Point this at the collector (local stack) or at a free Grafana Cloud OTLP
# gateway. Leave OTEL_ENABLED=false when no collector is reachable.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=chesspulse
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
# Grafana Cloud: `Authorization=Basic <base64(instanceId:token)>`
OTEL_EXPORTER_OTLP_HEADERS=
# Do not sample every trace in production.
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_METRIC_EXPORT_INTERVAL_MS=30000
OTEL_LOGS_ENABLED=true

# --- Observability stack (optional on a VM) -----------------------------------
GRAFANA_ADMIN_PASSWORD=replace_with_a_strong_random_password
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
ONCALL_TOKEN=replace_with_a_strong_random_token
ALERT_WEBHOOK_URL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20

# --- Chess.com provider -------------------------------------------------------
CHESS_COM_USER_AGENT=ChessPulse/0.1.0 (contact: replace-with-a-real-contact)
UPSTREAM_TIMEOUT_SECONDS=10
UPSTREAM_MAX_RETRIES=2
UPSTREAM_MAX_RETRY_AFTER_SECONDS=10

# --- Cache and analysis -------------------------------------------------------
CACHE_TTL_SECONDS=43200
REFRESH_FAILURE_COOLDOWN_SECONDS=300
STOCKFISH_PATH=/usr/games/stockfish
ANALYSIS_DEPTH=12
ANALYSIS_THREADS=1
ANALYSIS_HASH_MB=64
ANALYSIS_JOB_MAX_ATTEMPTS=3
ANALYSIS_WORKER_POLL_SECONDS=2
ANALYSIS_STALE_JOB_MINUTES=30
