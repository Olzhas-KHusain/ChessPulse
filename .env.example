# ChessPulse — example configuration.
# Copy to `.env` (cp .env.example .env). Never commit the real `.env`.
# The values below are local-development placeholders only, not real credentials.
# Change POSTGRES_PASSWORD AND the password inside DATABASE_URL together.

# --- Backend ---------------------------------------------------------------
# One of: development, test, production
APP_ENV=development
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# SQLAlchemy URL (psycopg 3 driver). Must match the POSTGRES_* values below.
DATABASE_URL=postgresql+psycopg://chesspulse:change_me@localhost:5432/chesspulse
# Comma-separated list of allowed browser origins (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Chess.com provider ------------------------------------------------------
# Chess.com recommends a recognizable User-Agent that includes contact information.
CHESS_COM_USER_AGENT=ChessPulse/0.1.0 (contact: change-me@example.com)
# Per-request HTTP timeout in seconds (0 < value <= 60)
UPSTREAM_TIMEOUT_SECONDS=10
# Extra attempts for transient failures (timeouts, 429, 5xx); 0-5
UPSTREAM_MAX_RETRIES=2
# Longest Retry-After / backoff delay waited inside one request; longer waits fail fast
UPSTREAM_MAX_RETRY_AFTER_SECONDS=10

# --- Cache policy -------------------------------------------------------------
# Serve a refreshed player dataset this long without contacting Chess.com (12 h:
# the provider documents that its data refreshes at most every 12 hours).
CACHE_TTL_SECONDS=43200
# Wait at least this long after a failed refresh (Retry-After wins when longer).
REFRESH_FAILURE_COOLDOWN_SECONDS=300

# --- Tests (optional) --------------------------------------------------------
# PostgreSQL server for database tests. Tests create and drop their own temporary
# databases on it (needs CREATEDB) and never touch the database named in the URL.
# When unset, DATABASE_URL's server is used. Read from the process environment only.
# TEST_DATABASE_URL=postgresql+psycopg://chesspulse:change_me@localhost:5432/postgres

# --- Local PostgreSQL (docker compose) --------------------------------------
POSTGRES_USER=chesspulse
POSTGRES_PASSWORD=change_me
POSTGRES_DB=chesspulse
POSTGRES_PORT=5432

# --- Frontend (Vite; only VITE_* variables reach the browser bundle) ---------
# Where the Vite dev server proxies /health and /api/* requests.
VITE_DEV_PROXY_TARGET=http://localhost:8000
# Base URL for API calls in a built bundle. Empty = same origin.
VITE_API_BASE_URL=
